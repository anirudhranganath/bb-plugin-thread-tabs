    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^30.1.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "bb plugin build",
    "test": "node --experimental-strip-types --test server.test.ts contracts.test.ts",
    "test:ui": "vitest run app.test.tsx message-fork-menu.test.ts",
    "verify": "npm run check && npm test && npm run test:ui"
